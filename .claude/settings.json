{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/report-guard.py\"",
            "timeout": 30,
            "statusMessage": "Report number contract"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/report-guard.py\"",
            "timeout": 90,
            "statusMessage": "Checking report figures"
          }
        ]
      }
    ]
  }
}
